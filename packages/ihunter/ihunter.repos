# The iHunter ROS 2 workspace, exactly.
#
#   ./packages/ihunter/import-workspace.sh          (or vcs import, if you have it)
#
# This file replaces clone_ihunter_ros_pkgs.sh, which had drifted: it was
# missing geo_tuner, mav_navigator_ros, ihunter_system and interception_guidance
# -- four of the packages the vehicle actually flies -- and several packages in
# the live workspace had been added by hand with no record of where they came
# from. A script that clones "the packages" is a list nobody remembers to edit;
# a manifest is a list that is obviously wrong when it is wrong.
#
# EVERY ENTRY IS PINNED TO A COMMIT, not a branch. A branch means two imports a
# month apart give different code, and the difference is invisible until
# something flies differently. To move a package forward: check out the new
# commit, test it, then update the SHA here in a commit of its own.
#
# SHAs below were read off the vehicle: originally the state flown on
# 2026-09-09, last reconciled against the vehicle on 2026-09-20.
#
# BUMPING A PIN IS PART OF DEPLOYING. When you deploy a new ihunter_system (or
# any package) to the vehicle, update its SHA here in the same sitting --
# otherwise import-workspace.sh reports drift on every board and people learn to
# ignore it, which costs more than the pin was ever worth.
#
# Private repositories use SSH URLs and need a read-only deploy key on the
# board; see bootstrap.sh. The image itself is built from public dependencies
# only, so no credential ever enters a Docker layer.

repositories:

  # --- the autopilot link -------------------------------------------------
  ros2_ws/src/mavlink:
    type: git
    url: https://github.com/ros2-gbp/mavlink-gbp-release.git
    version: bc5543fd574138d9e244a7f0600d7144fa537990   # release/humble/mavlink/2023.9.9-1
  ros2_ws/src/mavros:
    type: git
    url: https://github.com/mzahana/mavros.git
    version: 3b3804f6a73eee746d85798274238406c5e3f0a4

  # --- control ------------------------------------------------------------
  ros2_ws/src/mav_controllers_ros:
    type: git
    url: https://github.com/mzahana/mav_controllers_ros.git
    version: e8567a2cfb1c4ace7a085642cc8b4a4669623b25
  ros2_ws/src/geo_tuner:
    type: git
    url: https://github.com/mzahana/geo_tuner.git
    version: 9a7b4296e28004bf6f3bdf97fed81142ec7d1274

  # --- navigation and trajectories ----------------------------------------
  # PRIVATE
  ros2_ws/src/mav_navigator_ros:
    type: git
    url: git@github.com:khaledgabr77/mav_navigator_ros.git
    version: f8de115558a527a7042c6ae0433678afc4edf57f   # feature/production-navigator
  ros2_ws/src/custom_trajectory_msgs:
    type: git
    url: https://github.com/mzahana/custom_trajectory_msgs.git
    version: aff25722651209e532e7b845ef9bdc97d818567b
  ros2_ws/src/trajectory_generation:
    type: git
    url: https://github.com/mzahana/trajectory_generation.git
    version: f799c376b81e6383b4182eea8a84925761d842d9
    # interception_guidance LINKS this package (trajectory_generation::mpc_12state_lib,
    # the MPC embedded in the engagement manager). f799c37 is the first commit that
    # exports that target; anything older fails interception_guidance's build. Move
    # the two pins together.
  ros2_ws/src/trajectory_prediction:
    type: git
    url: https://github.com/mzahana/trajectory_prediction.git
    version: a8df225dab5a035b11ca7fd2713c76a67269f238
  ros2_ws/src/drone_path_predictor_ros:
    type: git
    url: https://github.com/mzahana/drone_path_predictor_ros.git
    version: 779e860e990f2f09a0fea8924ba8e4f9562148b6

  # --- perception and tracking --------------------------------------------
  ros2_ws/src/d2dtracker_drone_detector:
    type: git
    url: https://github.com/mzahana/d2dtracker_drone_detector.git
    version: 6ca791a0d306399d1f79a8755ed9b68396263029
  ros2_ws/src/multi_target_kf:
    type: git
    url: https://github.com/mzahana/multi_target_kf.git
    version: 5b5f6d9871fea0254d4f71242c59c69935c4bc9a
  ros2_ws/src/siyi_ros2:
    type: git
    url: https://github.com/mzahana/siyi_ros2.git
    version: 9dda970bd07559f981f51a713137f0194aac1489
  ros2_ws/src/siyi_msgs:
    type: git
    url: https://github.com/mzahana/siyi_msgs.git
    version: 7ca05374739c830941c4e76651cfe61d2169910b

  # --- the vehicle, and what it does --------------------------------------
  # PRIVATE. ihunter_system holds this airframe's numbers -- mass, thrust map,
  # gains, geofence, the operator CLI. interception_guidance holds the guidance
  # law. Everything above this line is generic; these two are the aircraft.
  ros2_ws/src/ihunter_system:
    type: git
    url: git@github.com:mzahana/ihunter_system.git
    version: 5c578eaaf3b96e723358174878f639ec2367430b
  ros2_ws/src/interception_guidance:
    type: git
    url: git@github.com:mzahana/interception_guidance.git
    version: 8641d88feae9fe35c6c52065d24095f4f0ce9a70
    # Read off the vehicle on 2026-09-20 (deployed and built there; the guidance
    # field flight is still pending). Builds only against trajectory_generation
    # >= f799c37 ON THE VEHICLE -- see the note on that entry. Since 8641d88 that
    # dependency is optional rather than REQUIRED, so the package also configures
    # on a machine with no MPC and no solver, building its RViz panels and
    # virtual_target_node but not engagement_manager_node. That is what lets the
    # operator laptop stage this package for its panels (install-laptop.sh);
    # it does not weaken the pin pair here, where the vehicle needs the node.

# --- deliberately NOT in this manifest ------------------------------------
#
# Present in the 2026-09-09 workspace, excluded here on purpose:
#
#   apriltag_ros          a git checkout with no remote configured; nothing in
#                         the flight stack depends on it.
#   balloon_tracker_cpp   no .git at all -- hand-copied, origin unrecorded.
#   balloon_bytetrack_cpp,
#   d2dtracker_sim        simulation-only; the SITL stack lives elsewhere.
#
# If any of these turns out to be needed for flight, find its origin and add it
# here rather than copying the directory onto the next board.
